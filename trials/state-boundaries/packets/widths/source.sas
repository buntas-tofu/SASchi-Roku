data work.stage;
  length short $3 joined $6;
  set work.have;
  short=raw;
  joined=short || suffix;
  if flag then tag='Y';
  else tag='LONG';
  keep row_id short joined tag;
run;
data work.want;
  length short $5 copy $2 wrapped $8;
  set work.stage;
  copy=short;
  short=short || '!';
  wrapped='[' || short || ']';
  n=length(short);
  z=lengthn(short);
  keep row_id short copy wrapped joined tag n z;
run;
